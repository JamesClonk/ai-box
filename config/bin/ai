#!/usr/bin/env bash
set -euo pipefail

# if param=="true", we will overwrite crush.json config file
WRITE_CONFIG="${1:-false}"

# credentials
SAIP_AUTH_URL="fix-me"
SAIP_CLIENT_ID="fix-me"
SAIP_CLIENT_SECRET="fix-me"

# fetch token
export SAIP_API_KEY=$(curl -sf -X POST "$SAIP_AUTH_URL" \
	-H "Accept: application/json" \
	-H "Content-Type: application/x-www-form-urlencoded" \
	-u "${SAIP_CLIENT_ID}:${SAIP_CLIENT_SECRET}" \
	-d "grant_type=client_credentials" | jq -r '.access_token')

if [[ -z "$SAIP_API_KEY" || "$SAIP_API_KEY" == "null" ]]; then
	echo "ERROR: Failed to obtain access token" >&2
	exit 1
fi

if [[ "$WRITE_CONFIG" == "true" ]]; then
	# write crush.json
	mkdir -p ~/.config/crush || true
	cat >~/.config/crush/crush.json <<EOF
{
  "\$schema": "https://charm.land/crush.json",
  "options": {
    "disable_metrics": true,
    "disable_provider_auto_update": true,
    "data_directory": "/home/vagrant/.crush",
    "attribution": {
      "trailer_style": "none",
      "generated_with": false
    }
  },
  "lsp": {
    "go": {
      "command": "gopls",
      "env": {
        "GOTOOLCHAIN": "go1.25.6"
      }
    }
  },
  "providers": {
    "saip": {
      "name": "saip",
      "type": "openai-compat",
      "base_url": "https://api.swisscom.com/products/swiss-ai-platform/internal-all-models/v1",
      "api_key": "\$SAIP_API_KEY",
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        }
      },
      "models": [
        {
          "id": "zai-org/glm-5.2-fp8",
          "name": "GLM-5.2",
          "context_window": 262144,
          "default_max_tokens": 32768,
          "default_reasoning_effort": "high",
          "supports_attachments": false,
          "cost_per_1m_in": 4.06,
          "cost_per_1m_out": 9.76
        },
        {
          "id": "qwen/qwen3.5-397b-a17b",
          "name": "Qwen3.5-397B-A17B",
          "context_window": 262144,
          "default_max_tokens": 65536,
          "can_reason": true,
          "supports_attachments": true,
          "cost_per_1m_in": 2.57,
          "cost_per_1m_out": 6.45
        }
      ]
    }
  },
  "mcp": {
    "kubernetes": {
      "type": "http",
      "url": "http://localhost:9280/mcp",
      "timeout": 120,
      "disabled": false,
      "disabled_tools": [
        "apply_resource",
        "manage_workload",
        "manage_cronjob",
        "manage_gitops",
        "manage_node"
      ]
    }
  }
}
EOF
	echo "crush.json written to ~/.config/crush/crush.json"
fi

echo "starting crush now ..."
crush
