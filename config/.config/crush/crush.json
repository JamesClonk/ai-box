{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "disable_metrics": true,
    "disable_provider_auto_update": true,
    "data_directory": "/home/vagrant/.crush",
    "attribution": {
      "trailer_style": "none",
      "generated_with": false
    }
  },
  "lsp": {
    "go": {
      "command": "gopls",
      "env": {
        "GOTOOLCHAIN": "go1.25.6"
      }
    }
  },
  "providers": {
    "saip": {
      "name": "saip",
      "type": "openai-compat",
      "base_url": "<YOUR_URL_HERE>/qwen3.5-397b-a17b/v1",
      "api_key": "<YOUR_API_KEY_HERE>",
      "extra_body": {
        "chat_template_kwargs": {
          "clear_thinking": true,
          "enable_thinking": true
        }
      },
      "models": [
        {
          "id": "zai-org/glm-5.3-flash",
          "name": "GLM-5.3 Flash",
          "context_window": 262144,
          "default_max_tokens": 32768,
          "reasoning_levels": ["high", "max"],
          "default_reasoning_effort": "max",
          "supports_attachments": false,
          "cost_per_1m_in": 1.34,
          "cost_per_1m_out": 3.26
        },
        {
          "id": "qwen/qwen3.5-397b-a17b",
          "name": "Qwen3.5-397B-A17B",
          "context_window": 262144,
          "default_max_tokens": 65536,
          "can_reason": true,
          "supports_attachments": true,
          "cost_per_1m_in": 2.57,
          "cost_per_1m_out": 6.45
        },
        {
          "id": "google/gemma-4-31b-it",
          "name": "Gemma-4-31b",
          "context_window": 262144,
          "default_max_tokens": 32768,
          "supports_attachments": false,
          "cost_per_1m_in": 0.34,
          "cost_per_1m_out": 1.01
        },
        {
          "id": "qwen/qwen3.8-27b",
          "name": "Qwen3.8-27b",
          "context_window": 262144,
          "default_max_tokens": 32768,
          "supports_attachments": false,
          "cost_per_1m_in": 0.37,
          "cost_per_1m_out": 0.77
        }
      ]
    },
    "llama.cpp": {
      "name": "llama.cpp",
      "type": "openai-compat",
      "base_url": "http://127.0.0.1:8080/v1",
      "models": [
        {
          "id": "unsloth/Qwen3.6-27B-GGUF:UD-Q6_K_XL",
          "name": "Qwen3.6-27B",
          "context_window": 65536,
          "default_max_tokens": 32768,
          "can_reason": true,
          "supports_attachments": true
        }
      ]
    }
  },
  "mcp": {
    "kubernetes": {
      "type": "http",
      "url": "http://localhost:9280/mcp",
      "timeout": 120,
      "disabled": false,
      "disabled_tools": [
        "apply_resource",
        "manage_workload",
        "manage_cronjob",
        "manage_gitops",
        "manage_node"
      ]
    }
  }
}
