{
  "name": "kiro",
  "description": "Customized kiro agent that should not read secretive config data",
  "resources": [
    "file://.kiro/steering/**/*.md",
    "skill://~/.kiro/skills/**/SKILL.md"
  ],
  "tools": ["*"],
  "allowedTools": ["*"],
  "toolsSettings": {
    "read": {
      "deniedPaths": [
        "~/.config/**",
        "~/.local/**"
      ]
    },
    "write": {
      "deniedPaths": [
        "~/.config/**",
        "~/.local/**"
      ]
    }
  }
}
